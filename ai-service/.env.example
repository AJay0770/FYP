PYTHON_AI_SERVICE_URL=http://localhost:8000
NODE_API_URL=http://localhost:3000
X_INTERNAL_TOKEN=your-shared-internal-secret

# Camera + detection. Machine-specific values belong in .env.local at the repo
# root (copy .env.local.example); these are the defaults the service falls back to.
CAMERA_TYPE=usb
CAMERA_SOURCE=0
STREAM_FORMAT=mjpeg
STREAM_PORT=8554
STREAM_FPS=12
INFERENCE_FPS=4
SAFETY_CONFIDENCE_THRESHOLD=0.5
ATTENDANCE_DISTANCE_THRESHOLD=0.65
YOLO_MODEL_PATH=models/best.pt
SAFETY_CAMERA_ID=
NO_PPE_VIOLATION_TYPE=NO_HELMET
# 15 minutes. Per (worker, violation type), not per camera - a violation is
# only ever raised against a specific enrolled worker (see safety_stream.py),
# so this is "don't re-alert on the same worker's ongoing violation", not
# "only one alert per camera every 15 minutes".
ALERT_COOLDOWN_SECONDS=900
# Cosine similarity threshold for attributing a safety violation to an
# enrolled worker (same model/threshold semantics as attendance matching -
# see FACE_MATCH_THRESHOLD's sibling ATTENDANCE_DISTANCE_THRESHOLD above and
# scripts/match_face.py's threshold-is-a-similarity-not-a-distance caveat).
# A hazard that doesn't clear this against any enrolled worker is shown on
# the feed but never alerted or counted as a violation.
FACE_MATCH_THRESHOLD=0.68
# How often (seconds) a camera re-fetches its project's enrolled-worker list
# for violation attribution. Long enough to avoid a Node round-trip on every
# matched frame, short enough that enrolling a worker mid-shift doesn't need
# a service restart to take effect.
WORKER_CACHE_TTL_SECONDS=300
ROBOFLOW_API_KEY=
