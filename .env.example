# Node.js Server
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://user:password@localhost:5432/buildsite360
JWT_SECRET=dev-jwt-secret-key-change-in-prod
JWT_REFRESH_SECRET=dev-jwt-refresh-secret-key-change-in-prod
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_S3_BUCKET=buildsite-dev
AWS_S3_ENDPOINT=http://localhost:9000
CORS_ORIGIN=http://localhost:5173
VITE_API_BASE_URL=http://localhost:3000/api
PYTHON_AI_SERVICE_URL=http://localhost:8000
X_INTERNAL_TOKEN=your-shared-internal-secret

# Email (Mailtrap sandbox)
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=465
SMTP_USER=your-mailtrap-user
SMTP_PASS=your-mailtrap-pass

# Payment (EasyPaisa Sandbox)
EASYPAISA_API_KEY=sandbox-key-here
EASYPAISA_MERCHANT_ID=sandbox-merchant-here

# React Client (used in vite.config.js)
VITE_API_BASE_URL=http://localhost:3000/api

# Python AI Service
PYTHON_AI_SERVICE_URL=http://localhost:8000
