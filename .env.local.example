# BuildSite360 - safety detection / camera configuration
#
# Copy to .env.local and edit. .env.local is gitignored and is loaded LAST by
# both the AI service and the setup scripts, so it overrides .env for the
# machine-specific parts (which camera, which GPU, which API key).
#
#   cp .env.local.example .env.local
#
# The Node server reads server/.env (dotenv is loaded from there); the values
# below that the server also needs - CAMERA_SOURCE, SAFETY_STREAM_URL,
# X_INTERNAL_TOKEN - must be present in its environment too. See
# SETUP_INSTRUCTIONS.md step 4.

# --- Camera ---------------------------------------------------------------
# CAMERA_TYPE is a label for humans and for /health; CAMERA_SOURCE is what is
# actually opened. Supported source shapes:
#   android_ip   http://192.168.1.100:8080/video      (IP Webcam app)
#   rtsp         rtsp://user:pass@192.168.1.64:554/Streaming/Channels/101
#   usb          0            (device index)  or  /dev/video0  on Linux
#   file         ./ai-service/data/test_clip.mp4      (loops - good for demos)
CAMERA_TYPE=android_ip
CAMERA_SOURCE=http://192.168.1.100:8080/video

# --- Streaming ------------------------------------------------------------
STREAM_FORMAT=mjpeg
STREAM_PORT=8554
STREAM_FPS=12
INFERENCE_FPS=4
STREAM_JPEG_QUALITY=80
STREAM_FRAME_WIDTH=960

# --- Detection ------------------------------------------------------------
SAFETY_CONFIDENCE_THRESHOLD=0.5
ATTENDANCE_DISTANCE_THRESHOLD=0.65
YOLO_MODEL_PATH=ai-service/models/best.pt

# Camera row that safety alerts are attributed to. Without it the detector still
# streams and counts, but nothing is written to the database - there is no
# camera to attach a SafetyAlert to. Get one from:
#   GET /api/projects/<projectId>/cameras
SAFETY_CAMERA_ID=

# The model class `no_ppe` has no matching value in the Prisma ViolationType
# enum (NO_HELMET | NO_VEST), so it is reported as this. See SETUP_INSTRUCTIONS.md
# if you would rather add a NO_PPE enum value and migrate.
NO_PPE_VIOLATION_TYPE=NO_HELMET
# 15 minutes, per (worker, violation type) - a violation is only ever raised
# against a specific enrolled worker (see safety_stream.py's per-worker face
# matching), so this means "don't re-alert the same worker's ongoing
# violation", not "one alert per camera every 15 minutes".
ALERT_COOLDOWN_SECONDS=900
# Cosine similarity threshold for attributing a violation to an enrolled
# worker. A hazard that doesn't clear this against any enrolled worker still
# shows on the feed, but is never alerted or counted as a violation - see
# scripts/match_face.py for why 0.68 here is much stricter than DeepFace's own
# published 0.68 (that one is a distance, this is a similarity).
FACE_MATCH_THRESHOLD=0.68
# How often (seconds) each camera re-fetches its project's enrolled-worker
# list. Long enough to avoid a Node round-trip on every matched frame, short
# enough that enrolling a worker mid-shift doesn't need a service restart.
WORKER_CACHE_TTL_SECONDS=300

# --- Service wiring -------------------------------------------------------
NODE_API_URL=http://localhost:3000
SAFETY_STREAM_URL=http://127.0.0.1:8554
# Must be byte-identical to X_INTERNAL_TOKEN in server/.env, or every alert is
# rejected with 401.
X_INTERNAL_TOKEN=your-shared-internal-secret

# --- Dataset (optional) ---------------------------------------------------
# Only needed by scripts/download_dataset.py --source roboflow.
ROBOFLOW_API_KEY=
ROBOFLOW_WORKSPACE=roboflow-universe-projects
ROBOFLOW_PROJECT=construction-site-safety
ROBOFLOW_VERSION=30
